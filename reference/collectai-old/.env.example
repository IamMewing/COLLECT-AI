# ============================================
# CollectAI — Environment Variables
# ============================================
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.
# ============================================

# Server
PORT=3000

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here

# Firebase / Firestore (Choose one of the following):
# Option 1: Full Service Account JSON string or Base64 (Ideal for Render / Railway / Vercel env vars)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Option 2: Individual variables
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=your-firebase-adminsdk@...
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Option 3: Local service account file path
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Email (SMTP) — for MVP, use Ethereal for testing
# Sign up at https://ethereal.email to get test credentials
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-user@ethereal.email
SMTP_PASS=your-ethereal-password
SMTP_FROM_NAME=CollectAI
SMTP_FROM_EMAIL=noreply@collectai.app
