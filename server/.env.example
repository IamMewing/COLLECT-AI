# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored — never commit real secrets.

# ── Server ────────────────────────────────────────────────────────────────
PORT=3001
# Path to the Python interpreter that has `requirements.txt` installed
# (point this at your venv's python, e.g. ../venv/bin/python or ..\venv\Scripts\python.exe)
PYTHON_PATH=python

# ── Agent model provider ─────────────────────────────────────────────────
# Set USE_MOCK=true to run the whole pipeline with zero API calls/cost.
USE_MOCK=true
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Real email sending (optional — stub/print is used otherwise) ────────
SEND_REAL_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Fallback recipient for invoices with no per-client `email` on file.
DEMO_RECIPIENT_EMAIL=

# ── Autonomous negotiation loop (optional) ───────────────────────────────
# Reads replies via IMAP using the SAME SMTP_USER/SMTP_PASS above (a Gmail
# App Password authorizes both) — no extra credentials needed. Trigger it
# by calling POST /api/agent/check-replies on a schedule (e.g. a Cloud
# Scheduler job every few minutes); see agent/inbox.py.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# false (default): the agent still reads replies and decides what to say
# next, but queues its reply for human review instead of sending it.
# true: it sends its own follow-up replies unattended.
AUTO_APPROVE_NEGOTIATION=false
# Shared secret an unattended scheduled job presents via the
# X-Scheduler-Secret header to call /api/agent/check-replies with no
# browser session cookie. Leave unset to require the normal password-gate
# cookie instead (fine for calling it manually, not for a scheduled job).
SCHEDULER_SECRET=

# ── WhatsApp (Meta's own Cloud API — not Twilio) ─────────────────────────
# From developers.facebook.com -> your app -> WhatsApp -> API Setup.
# A test-mode token/number is free (no card needed) and can message any
# phone numbers you add as testers there. See agent/tools/whatsapp_tools.py.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# An arbitrary secret string YOU choose (not from Meta) — enter this same
# value when registering the webhook URL in the Meta app dashboard; it's
# how GET /api/whatsapp/webhook proves to Meta that you control this URL.
META_WHATSAPP_VERIFY_TOKEN=
# From the Meta app's Settings -> Basic -> App Secret. Used to verify the
# X-Hub-Signature-256 header on every inbound POST /api/whatsapp/webhook
# call — NOT the same thing as the access token above.
META_WHATSAPP_APP_SECRET=
# Set true ONLY for local testing without a publicly reachable URL for Meta
# to sign its webhook calls against. Must be unset wherever this server is
# actually internet-reachable.
META_WHATSAPP_WEBHOOK_ALLOW_UNVERIFIED=false

# ── SMS/Voice (Twilio — optional; this project has no number configured) ─
# From console.twilio.com -> Account -> API keys & tokens. Getting a number
# usable via the API (not just Twilio's own console "Try out" demo) now
# requires upgrading to a paid account — see README — so these are blank
# by default and every SMS/voice send stays a print-only stub until set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A plain Twilio phone number (E.164, e.g. '+15017122661') for SMS and for
# every outbound AI voice call (POST /api/agent/invoices/:id/call) — one
# Twilio number handles both, so there's no separate TWILIO_VOICE_FROM.
TWILIO_SMS_FROM=
# Set true ONLY for local testing without a publicly reachable URL for
# Twilio to sign its webhook calls against — covers every Twilio webhook
# this server exposes (POST /api/twilio/webhook for inbound SMS, and
# POST /api/twilio/voice + /voice/gather + /voice/status for calls).
# Must be unset wherever this server is actually internet-reachable.
TWILIO_WEBHOOK_ALLOW_UNVERIFIED=false

# ── Persistence (optional — local JSON files under server/ and agent/data/
# are used otherwise, which do NOT survive a Cloud Run cold start) ────────
FIRESTORE_ENABLED=false

# ── Shared-password gate for a public demo deployment (optional) ────────
# Leave unset to leave the whole app open (the default — matches local dev
# and every deployment before this existed). Set it to lock the live URL
# behind one shared password (e.g. for hackathon judges) so a stranger who
# finds the Cloud Run URL can't read the ledger or run the agent on the
# shared Gemini key. See server/auth.js.
ACCESS_PASSWORD=
# Optional: rotate the session-signing key independently of the password
# above. Auto-derived from ACCESS_PASSWORD if left unset.
SESSION_SECRET=

# ── PayPal (sandbox) ──────────────────────────────────────────────────────
# From developer.paypal.com -> Apps & Credentials -> Sandbox -> your app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 'sandbox' or 'live' — leave as sandbox for the hackathon submission.
PAYPAL_ENV=sandbox
# Set once you create a webhook subscription in the Developer Dashboard and
# copy its Webhook ID here (needed to verify incoming webhook calls).
PAYPAL_WEBHOOK_ID=
# A sandbox PERSONAL (buyer) test account email — demo invoices use fictional
# clients, so every real sandbox invoice is sent to this address so you can
# actually pay it yourself during the demo.
PAYPAL_DEMO_BUYER_EMAIL=
# Optional: the sandbox BUSINESS (merchant) account's email, as the invoicer.
PAYPAL_MERCHANT_EMAIL=
PAYPAL_CURRENCY=USD
# Demo invoices are seeded in INR; PayPal sandbox needs a currency the test
# merchant account accepts. Adjust if you want a more current rate.
PAYPAL_DEMO_INR_PER_USD=83
